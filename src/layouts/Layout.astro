---
import '../styles/global.css'
import SplashScreen from '../components/SplashScreen.astro';

interface Props {
  title: string;
  description?: string;
  showSplash?: boolean;
  ogImage?: string;
  canonicalPath?: string;
}

const SITE_URL = "https://portafolio-uxui-julisaleon.vercel.app";

// showSplash por defecto es false — solo la home lo activa explícitamente
const {
  title,
  description = "UX/UI Designer & Developer - Creando experiencias digitales memorables",
  showSplash = false,
  ogImage = "/miniatura.png",
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonicalURL = `${SITE_URL}${canonicalPath}`;
const ogImageURL = `${SITE_URL}${ogImage}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Julisa | UX/UI Designer & Developer" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} - Preview`} />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${title} - Preview`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KPD13TEE5R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      // eslint-disable-next-line prefer-rest-params
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KPD13TEE5R');
    </script>
  </head>
  <body class="antialiased">
    <!-- Noise overlay -->
    <div class="noise"></div>
    
    <!-- Custom cursor -->
    <div class="cursor hidden lg:block" id="cursor"></div>
    
    <!-- Page transition overlay (para navegación entre páginas, z inferior al splash) -->
    <div class="page-transition fixed inset-0 bg-[var(--color-primary)] z-[9998] transform translate-y-full pointer-events-none invisible" id="page-transition"></div>

    <!-- Splash Screen (solo en home) -->
    {showSplash && <SplashScreen />}

    <!-- WhatsApp widget -->
    <a
      id="wsp-widget"
      href="https://wa.me/51906259258?text=Hola%20Julisa%2C%20vi%20tu%20portfolio%20y%20me%20gustar%C3%ADa%20contactarte"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <!-- Ícono oficial WhatsApp -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <style>
      #wsp-widget {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 9990;
        width: 3rem;
        height: 3rem;
        background: #25D366;
        color: #fff;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
        opacity: 0;
        pointer-events: none;
        transform: translateY(10px);
        transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      #wsp-widget.wsp-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }

      #wsp-widget svg {
        width: 1.5rem;
        height: 1.5rem;
      }

      #wsp-widget.wsp-visible:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 28px rgba(37, 211, 102, 0.5);
      }

      @media (max-width: 767px) {
        #wsp-widget {
          bottom: 1.25rem;
          right: 1.25rem;
          width: 2.75rem;
          height: 2.75rem;
        }
      }
    </style>

    <script>
      // Mostrar widget de WhatsApp solo después de salir del hero
      const wspWidget = document.getElementById('wsp-widget');
      if (wspWidget) {
        const heroSection = document.querySelector('[data-hero="home"]');
        if (heroSection) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach(entry => {
                if (!entry.isIntersecting) {
                  wspWidget.classList.add('wsp-visible');
                } else {
                  wspWidget.classList.remove('wsp-visible');
                }
              });
            },
            { threshold: 0.1 }
          );
          observer.observe(heroSection);
        } else {
          // En páginas sin hero, mostrar siempre
          wspWidget.classList.add('wsp-visible');
        }
      }
    </script>
    
    <slot />

    <!-- Scroll suave, cursor y animaciones (ver src/scripts/) -->
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
