---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import DesktopShowcase from '../../components/DesktopShowcase.astro';
import MobileShowcase from '../../components/MobileShowcase.astro';
import { project } from '../../data/projects/comsatel';
---

<ProjectLayout
  project={project}
  heroImage={{ src: '/images/projects/comsatel/herocomsatel1.webp' }}
  process={{
    title: 'Adaptación y resiliencia',
    subtitle: 'Este proyecto fue un reto de adaptación: continuar un diseño sin documentación previa y crear orden donde no lo había.',
  }}
>
    <!-- Desktop Showcase -->
    <DesktopShowcase
      title="Pantallas Desktop"
      subtitle="Diseño UI"
      sections={[
        {
          title: "Páginas Principales",
          pages: project.desktopShowcase.mainPages,
          columns: 2
        },
        {
          title: "Sectores y Servicios",
          pages: project.desktopShowcase.servicesPages,
          columns: 3
        },
        {
          title: "Cotizador",
          pages: project.desktopShowcase.quoterPages,
          columns: 3
        },
        {
          title: "Herramientas y Formularios",
          pages: project.desktopShowcase.toolsPages,
          columns: 3
        }
      ]}
    />

    <!-- Mobile Showcase -->
    <MobileShowcase
      title="Experiencia Mobile"
      subtitle="Responsive Design"
      screens={project.mobileShowcase}
    />
</ProjectLayout>
