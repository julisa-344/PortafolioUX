---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import BrowserMockup from '../../components/BrowserMockup.astro';
import MobileShowcase from '../../components/MobileShowcase.astro';
import { project } from '../../data/projects/xplora';
---

<ProjectLayout
  project={project}
  heroImage={{ src: '/images/projects/xplora/home.webp', alt: 'Xplora — Vista principal del rediseño' }}
  process={{
    title: 'Del research al código',
    subtitle: 'Un proceso end-to-end: investigación de usuarios, perfilado, rediseño de filtros e implementación directa en el repositorio.',
  }}
  floating={false}
>
    <!-- Desktop Showcase + Video -->
    <section class="py-24 border-t border-[var(--color-border)]">
      <div class="max-w-[1800px] mx-auto px-6 md:px-12 lg:px-16">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <p class="reveal text-[var(--color-text-muted)] text-sm uppercase tracking-[0.3em] mb-4" data-delay="0">
            Diseño UI
          </p>
          <h2 class="reveal font-serif text-4xl md:text-5xl lg:text-6xl font-medium" data-delay="0.1">
            Pantallas Desktop
          </h2>
        </div>

        <!-- BrowserMockups -->
        <div class="space-y-24">
          <div>
            <h3 class="reveal font-serif text-2xl md:text-3xl font-medium mb-10 text-[var(--color-text)]" data-delay="0">
              Páginas principales
            </h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              {project.desktopShowcase.mainPages.map((page, index) => (
                <div class="reveal" data-delay={0.1 + index * 0.05}>
                  <BrowserMockup
                    src={page.src}
                    alt={page.alt}
                    label={page.label}
                    url={page.url}
                    height="500px"
                  />
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Antes & Después -->
    <section class="py-24 bg-[var(--color-primary)] overflow-hidden">
      <div class="max-w-[1800px] mx-auto px-6 md:px-12 lg:px-16">
        <!-- Header centrado -->
        <div class="text-center mb-16">
          <p class="reveal text-white/60 text-sm uppercase tracking-[0.35em] mb-4" data-delay="0">
            El resultado
          </p>
          <h2 class="reveal font-serif text-5xl md:text-6xl lg:text-7xl font-medium text-white" data-delay="0.1">
            Antes &amp; Después
          </h2>
          <p class="reveal text-white/70 text-lg mt-5 max-w-xl mx-auto" data-delay="0.2">
            De una interfaz confusa a una experiencia fluida y personalizada.
          </p>
        </div>

        <!-- Comparación lado a lado -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
          <!-- Antes -->
          <div class="reveal" data-delay="0.15">
            <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-4 text-center">Antes</p>
            <BrowserMockup
              src="/images/projects/xplora/antes.webp"
              alt="Versión original de Xplora antes del rediseño"
              label="Versión original"
              url="xplora.chat"
              height="480px"
            />
          </div>

          <!-- Después -->
          <div class="reveal" data-delay="0.2">
            <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-4 text-center">Después</p>
            <!-- Video mockup manual para mantener consistencia visual -->
            <div class="browser-mockup-video rounded-xl overflow-hidden shadow-2xl">
              <!-- Chrome bar -->
              <div class="flex items-center gap-3 px-4 py-3 bg-[var(--color-bg-secondary)] border-b border-[var(--color-border)]">
                <div class="flex gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#ff5f56] opacity-70"></span>
                  <span class="w-3 h-3 rounded-full bg-[#ffbd2e] opacity-70"></span>
                  <span class="w-3 h-3 rounded-full bg-[#27c93f] opacity-70"></span>
                </div>
                <div class="flex-1 flex items-center gap-2 bg-white/60 rounded-md px-3 py-1.5 border border-[var(--color-border)]">
                  <svg class="w-3.5 h-3.5 text-[var(--color-text-muted)] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                  </svg>
                  <span class="text-xs text-[var(--color-text-muted)] font-medium truncate">xplora.chat</span>
                </div>
              </div>
              <!-- Video: overflow hidden en el wrapper recorta las franjas negras -->
              <div style="height: 480px; overflow: hidden; position: relative;">
                <video
                  src="/images/projects/xplora/xplora.mp4"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; height: 130%; object-fit: cover;"
                ></video>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mobile Showcase -->
    <MobileShowcase
      title="Experiencia Mobile"
      subtitle="Responsive Design"
      screens={project.mobileShowcase}
    />
</ProjectLayout>
