---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import DesktopShowcase from '../../components/DesktopShowcase.astro';
import { project } from '../../data/projects/bitdefender';
---

<ProjectLayout
  project={project}
  heroImage={{ src: '/images/projects/bitdefender/heroBitdefender.webp', class: 'aspect-[21/9] object-center' }}
  process={{
    title: 'De la investigación a los wireframes',
    subtitle: 'Un proceso de UX Research enfocado en entender el mercado de ciberseguridad y diseñar una experiencia optimizada para dos segmentos de usuarios.',
  }}
  highlightsTitle="Resultados del research"
>
    <DesktopShowcase
      title="Wireframes del proyecto"
      subtitle="Entregables"
      sections={[
        {
          title: "Páginas Principales",
          columns: 3,
          pages: [
            { src: '/images/projects/bitdefender/home.webp', label: 'Home', alt: 'Bitdefender - Página principal', url: 'bitdefender.com' },
            { src: '/images/projects/bitdefender/hogar.webp', label: 'Hogar', alt: 'Bitdefender - Productos para hogar', url: 'bitdefender.com/hogar' },
            { src: '/images/projects/bitdefender/Products.webp', label: 'Productos', alt: 'Bitdefender - Lista de productos', url: 'bitdefender.com/products' }
          ]
        },
        {
          title: "Blog y Contacto",
          columns: 3,
          pages: [
            { src: '/images/projects/bitdefender/blog.webp', label: 'Blog', alt: 'Bitdefender - Blog', url: 'bitdefender.com/blog' },
            { src: '/images/projects/bitdefender/blog-detalle.webp', label: 'Blog Detalle', alt: 'Bitdefender - Artículo de blog', url: 'bitdefender.com/blog/post' },
            { src: '/images/projects/bitdefender/contacto.webp', label: 'Contacto', alt: 'Bitdefender - Contacto', url: 'bitdefender.com/contacto' }
          ]
        },
        {
          title: "Flujo de Compra",
          columns: 3,
          pages: [
            { src: '/images/projects/bitdefender/cart.webp', label: 'Carrito', alt: 'Bitdefender - Carrito de compras', url: 'bitdefender.com/cart' },
            { src: '/images/projects/bitdefender/Account.webp', label: 'Mi Cuenta', alt: 'Bitdefender - Mi cuenta', url: 'bitdefender.com/account' },
            { src: '/images/projects/bitdefender/Gracias.webp', label: 'Confirmación', alt: 'Bitdefender - Página de gracias', url: 'bitdefender.com/gracias' }
          ]
        },
        {
          title: "Sección Empresas",
          columns: 2,
          pages: [
            { src: '/images/projects/bitdefender/empresa-detalle.webp', label: 'Empresa Detalle', alt: 'Bitdefender - Detalle para empresas', url: 'bitdefender.com/empresa' },
            { src: '/images/projects/bitdefender/Account-1.webp', label: 'Cuenta Empresa', alt: 'Bitdefender - Cuenta empresarial', url: 'bitdefender.com/cuenta' }
          ]
        }
      ]}
    />
</ProjectLayout>
