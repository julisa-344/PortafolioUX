---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import DesktopShowcase from '../../components/DesktopShowcase.astro';
import MobileShowcase from '../../components/MobileShowcase.astro';
import { project } from '../../data/projects/intense';
---

<ProjectLayout
  project={project}
  heroImage={{ src: '/images/projects/intense/heroIntense.webp' }}
  process={{
    title: 'De la investigación al diseño',
    subtitle: 'Un proceso completo de UX/UI: desde el kick-off y research hasta wireframes de todas las pantallas y diseño visual final.',
  }}
>
    <!-- Desktop Showcase -->
    <DesktopShowcase
      title="Pantallas Desktop"
      subtitle="Diseño UI"
      sections={[
        {
          title: "Páginas Principales",
          pages: project.desktopShowcase.mainPages,
          columns: 2
        },
        {
          title: "Journeys e Itinerarios",
          pages: project.desktopShowcase.journeysPages,
          columns: 2
        },
        {
          title: "Blog y Contacto",
          pages: project.desktopShowcase.contentPages,
          columns: 2
        }
      ]}
    />

    <!-- Mobile Showcase -->
    <MobileShowcase
      title="Experiencia Mobile"
      subtitle="Responsive Design"
      screens={project.mobileShowcase}
    />
</ProjectLayout>
